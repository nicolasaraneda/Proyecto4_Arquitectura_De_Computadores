# placa_x2.pcf: pines de la prueba del duplicador en la Go Board.
#
# Grupo: Nicolás Araneda, Vicente Calderón y Santiago Muñoz.
# Arquitectura de Computadores, Universidad de los Andes, 2026-2.
#
# Mismos pines que goboard.pcf. Del conector PMOD se usa solo el pin 63
# (MISO en el SoC, que también es salida), como punto de prueba.

# Reloj de 25 MHz
set_io i_Clk 15

# LED
set_io o_LED[0] 56
set_io o_LED[1] 57
set_io o_LED[2] 59
set_io o_LED[3] 60

# Botones
set_io i_Switch[0] 53
set_io i_Switch[1] 51
set_io i_Switch[2] 54
set_io i_Switch[3] 52

# Display izquierdo
set_io o_Segment1_A 3
set_io o_Segment1_B 4
set_io o_Segment1_C 93
set_io o_Segment1_D 91
set_io o_Segment1_E 90
set_io o_Segment1_F 1
set_io o_Segment1_G 2

# Display derecho
set_io o_Segment2_A 100
set_io o_Segment2_B 99
set_io o_Segment2_C 97
set_io o_Segment2_D 95
set_io o_Segment2_E 94
set_io o_Segment2_F 8
set_io o_Segment2_G 96

# Punto de prueba: pin MISO del PMOD
set_io o_Prueba 63
